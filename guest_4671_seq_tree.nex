	set branchLabels.isShown=false;
	set branchLabels.significantDigits=4;
	set colour.order.lca="lca:(n31) Homo sapiens / species,(n30) Homo / genus*,(n29) Homininae / subfamily*,(n28) Hominidae / family,(n27) Hominoidea / superfamily,(n26) Catarrhini / parvorder,(n25) Simiiformes / infraorder,(n24) Haplorrhini / suborder*,(n23) Primates / order,(n22) Euarchontoglires / superorder,(n21) Boreoeutheria / clade,(n20) Eutheria / clade,(n19) Theria / clade,(n18) Mammalia / class,(n17) Amniota / clade*,(n16) Tetrapoda / clade,(n15) Dipnotetrapodomorpha / clade*,(n14) Sarcopterygii / superclass,(n13) Euteleostomi / clade,(n12) Teleostomi / clade*,(n11) Gnathostomata / clade,(n10) Vertebrata / clade*,(n9) Craniata / subphylum*,(n8) Chordata / phylum,(n7) Deuterostomia / clade,(n6) Bilateria / clade,(n5) Eumetazoa / clade,(n4) Metazoa / kingdom*,(n3) Opisthokonta / clade*,(n2) Eukaryota / domain,(n1) cellular organisms / cellular root";
