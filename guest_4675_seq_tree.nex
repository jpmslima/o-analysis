	set colour.order.lca="lca:(n31) Homo sapiens / species,(n30) Homo / genus*,(n29) Homininae / subfamily,(n28) Hominidae / family*,(n27) Hominoidea / superfamily,(n26) Catarrhini / parvorder,(n25) Simiiformes / infraorder,(n24) Haplorrhini / suborder*,(n23) Primates / order*,(n22) Euarchontoglires / superorder,(n21) Boreoeutheria / clade,(n20) Eutheria / clade";
